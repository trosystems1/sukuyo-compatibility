{
  "name": "sukuyo-compatibility",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/shuku-regression.test.cjs && node tests/middleware-public-daily.test.mjs",
    "sync:www": "mkdir -p www && cp index.html sukuyo-about.html senseiban.html www/ && cp -r assets www/",
    "ios": "npm run sync:www && npx cap sync ios && npx cap run ios --target-name \"iPhone 17 Pro\""
  },
  "dependencies": {
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/splash-screen": "^8.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "lunar-javascript": "1.7.4"
  },
  "overrides": {
    "replace": {
      "minimatch": "3.1.4"
    }
  }
}
